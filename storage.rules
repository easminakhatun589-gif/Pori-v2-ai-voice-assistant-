rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // APK Releases directory
    match /releases/{allPaths=**} {
      // Public download for app clients over HTTPS
      allow read: if true;
      // Only authenticated Owner / Admins can upload or delete APK files
      allow write: if request.auth != null && (
        request.auth.token.get('email', '') == 'mdaslamlaskar14@gmail.com' ||
        request.auth.token.get('email', '') == 'easminakhatun589@gmail.com' ||
        request.auth.token.get('role', '') == 'owner' ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('admin', false) == true
      );
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
